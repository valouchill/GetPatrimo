PORT=3000

# --- JWT ---
JWT_SECRET=change-moi-avec-une-grande-chaine-aleatoire

# --- MongoDB ---
# IMPORTANT: Utiliser un mot de passe fort, ne JAMAIS commit le .env
MONGO_URI=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@mongodb:27017/doc2loc?authSource=admin
MONGO_USER=admin
MONGO_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Brevo (SMTP) ---
BREVO_USER=your-brevo-user@smtp-brevo.com
BREVO_PASS=xsmtpsib-your-brevo-key

# --- Admin ---
# Bootstrap superadmin : tout email listé ici est auto-promu 'superadmin' à la 1ère connexion
# (le rôle est ensuite persisté en DB — retirer l'env ne rétrograde pas).
# Format : valeurs séparées par des virgules, ex. "alice@x.com,bob@x.com"
ADMIN_EMAILS=admin@doc2loc.com
MAIL_FROM="Doc2Loc <no-reply@doc2loc.com>"
MAIL_REPLY_TO="contact@doc2loc.com"

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-your-openai-key

# --- NextAuth (connexion plateforme) ---
NEXTAUTH_URL=https://doc2loc.com
NEXTAUTH_SECRET=change-moi-avec-une-grande-chaine-aleatoire
NEXT_PUBLIC_BASE_URL=https://doc2loc.com

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_your-stripe-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-signing-secret
PRICE_ID_ONESHOT=price_xxx
PRICE_ID_RECURRING=price_xxx

# --- Didit Identity Verification ---
# Obtenir ces cles sur https://business.didit.me
DIDIT_API_KEY=your-didit-api-key
DIDIT_WORKFLOW_ID=your-workflow-id
DIDIT_WEBHOOK_URL=https://doc2loc.com/api/webhooks/didit
DIDIT_ISSUER_URL=https://apx.didit.me
DIDIT_CLIENT_ID=your-client-id
DIDIT_CLIENT_SECRET=your-client-secret
DIDIT_REDIRECT_URI=https://verify.didit.me/u/your-redirect

# --- Sentry (Error Tracking) ---
# Obtenir le DSN sur https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=

# --- OpenAI Cost Control ---
OPENAI_MONTHLY_COST_ALERT=50
OPENAI_MONTHLY_COST_LIMIT=200

# --- Phase 1 Auditeur Forensic ---
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.1-pro-preview

MISTRAL_API_KEY=your-mistral-key
MISTRAL_OCR_MODEL=mistral-ocr-latest

FORENSIC_METADATA_COMMAND=/opt/doc2loc/scripts/extract-metadata.js

FORENSIC_THRESHOLD_TRUST_MAX=20
FORENSIC_THRESHOLD_DOUBT_MAX=80

FORENSIC_METADATA_TIMEOUT_MS=15000
MISTRAL_TIMEOUT_MS=45000
GEMINI_TIMEOUT_MS=45000
FORENSIC_MATH_TOLERANCE=1

FORENSIC_SUSPICIOUS_SOFTWARE=Adobe Photoshop,Canva,GIMP,Paint,Illustrator,InDesign,ImageMagick,ILovePDF,Smallpdf,Sejda
FORENSIC_LEGITIMATE_SOFTWARE=Payfit,Sage,Cegid,Silae,ADP,Lucca,Microsoft,LibreOffice,Apache,iText,PDFKit

# ============================================================================
# Pipeline Hybride d'analyse documentaire (Modules A / B / C / D)
# Tout est GATED : sans ces variables, le pipeline garde le comportement actuel
# (extraction GPT-4o Vision). Validation : scripts/smoke-pipeline.js
# ============================================================================

# --- Module B : OCR déterministe Azure Document Intelligence (repli Vision auto) ---
# ⚠️ REGION OBLIGATOIRE si l'endpoint *.cognitiveservices.azure.com n'embarque pas la
#    région : sinon le garde-fou RGPD laisse Azure désactivé (repli Vision SILENCIEUX).
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=your-azure-document-intelligence-key
AZURE_DOC_INTELLIGENCE_REGION=westeurope   # UE : westeurope|francecentral|northeurope|swedencentral|...
AZURE_DOC_INTELLIGENCE_PRICE_EUR_PER_PAGE=0.01   # coût cockpit (ton tarif réel par page)
AZURE_DOC_INTELLIGENCE_TIMEOUT_MS=30000
AZURE_OCR_DISABLED=false                   # kill-switch : true = force le repli Vision

# --- Module D : Superviseur documentaire (gpt-4o-mini, JSON-only) ---
# Réutilise OPENAI_API_KEY (aucune nouvelle clé). N'attribue jamais de note.
DOC_SUPERVISOR_ENABLED=false               # true pour activer
OPENAI_DOC_SUPERVISOR_MODEL=gpt-4o-mini
OPENAI_DOC_SUPERVISOR_TIMEOUT_MS=20000
# Option : basculer aussi le scoring dossier en mini (défaut gpt-4o-2024-08-06)
# OPENAI_ANALYSIS_MODEL=gpt-4o-mini

# --- Module C : sceau 2D-Doc de l'avis d'imposition (décodage libdmtx + vérif offline) ---
# Vérifie la signature ECDSA du 2D-Doc contre la TSL officielle ANTS EMBARQUÉE
# (lib MIT betagouv/2ddoc-parser) — HORS-LIGNE, sans l'API ANTS. Puis recoupe le
# RFR/numéro fiscal SCELLÉ avec l'OCR. Prérequis runtime (en plus de Python) :
#   système : libdmtx0
#   pip     : pylibdmtx Pillow fr_2ddoc_parser  (tire pydantic + cryptography)
FISCAL_SEAL_VERIFICATION_ENABLED=false
FISCAL_SEAL_TIMEOUT_MS=12000   # timeout du sous-processus Python (décodage + vérif)
DMTX_TIMEOUT_MS=8000           # timeout du décodage DataMatrix (libdmtx)
# PYTHON_BIN=python3           # binaire Python si non standard
